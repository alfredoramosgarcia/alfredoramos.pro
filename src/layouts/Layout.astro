---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Background from "../components/layout/Background.astro";
import SpeedInsights from "@vercel/speed-insights/astro";

const {
	pageTitle = "Alfredo Ramos",
	description = "Software engineer focused on reliable products, systems and security.",
	ogimage = {
		url: "/images/projects/alfredoramospro.png",
		alt: "Alfredo Ramos portfolio",
	},
	titleKey,
	descriptionKey,
	ogAltKey,
} = Astro.props;

const siteUrl = new URL(Astro.url).origin;
const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).toString()
	: Astro.url.toString();
---

<html
	lang="en"
	data-language="en"
	class="scroll-smooth bg-[#fafafa] font-montserrat antialiased dark:bg-[#09090b]"
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title data-i18n={titleKey}>{pageTitle}</title>
		<meta
			name="description"
			content={description}
			data-i18n-content={descriptionKey}
		/>
		<meta name="author" content="Alfredo Ramos" />
		<meta name="robots" content="index, follow" />
		<meta
			name="theme-color"
			content="#fafafa"
			media="(prefers-color-scheme: light)"
		/>
		<meta
			name="theme-color"
			content="#09090b"
			media="(prefers-color-scheme: dark)"
		/>
		<link rel="canonical" href={canonical} />

		<link rel="icon" href="/logo.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta
			property="og:title"
			content={pageTitle}
			data-i18n-content={titleKey}
		/>
		<meta
			property="og:description"
			content={description}
			data-i18n-content={descriptionKey}
		/>
		<meta property="og:image" content={`${siteUrl}${ogimage.url}`} />
		<meta
			property="og:image:alt"
			content={ogimage.alt}
			data-i18n-content={ogAltKey}
		/>
		<meta property="og:url" content={Astro.url.toString()} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Alfredo Ramos" />
		<meta property="og:locale" content="en_GB" />

		<script is:inline>
			(() => {
				const storedTheme = localStorage.getItem("theme");
				const dark = storedTheme
					? storedTheme === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);

				const supported = ["en", "es", "fr", "de", "da", "zh"];
				const storedLanguage = localStorage.getItem("portfolio-language");
				const language = supported.includes(storedLanguage || "")
					? storedLanguage
					: "en";
				document.documentElement.dataset.language = language;
				document.documentElement.lang = language === "zh" ? "zh-CN" : language;
				if (language !== "en") {
					document.documentElement.classList.add("i18n-pending");
					window.setTimeout(
						() => document.documentElement.classList.remove("i18n-pending"),
						1200,
					);
				}
			})();
		</script>
	</head>
	<body
		class="min-h-screen overflow-x-hidden bg-[#fafafa] text-zinc-950 selection:bg-blue-600 selection:text-white dark:bg-[#09090b] dark:text-zinc-100"
	>
		<SpeedInsights />
		<Background />
		<div class="relative z-10 min-h-screen">
			<Header />
			<main><slot /></main>
			<Footer />
		</div>
		<script>
			import "../scripts/i18n";
		</script>
	</body>
</html>
