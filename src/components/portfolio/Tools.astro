---
const allTools = [
  "typescript",
  "javascript",
  "react",
  "nextjs",
  "node",
  "java",
  "python",
  "postgres",
  "mysql",
  "docker",
  "kubernetes",
  "git",
  "astro",
  "tailwind",
];

import Capsule from "../ui/Capsule.astro";
type ToolVariant = "default" | "center";
const { variant = "default", linkEnabled = false, size = "md" } = Astro.props;
const classes = variant === "center" ? "flex flex-wrap justify-center gap-2" : "flex flex-wrap gap-2";
---

<div class={classes}>
  {allTools.map((tool) => <Capsule lang={tool} linkEnabled={linkEnabled} size={size} />)}
</div>
