---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "Dec 2023 — Present",
    title: "Software Engineer",
    company: "ALTEN Spain",
    description: "Software engineering consultant in the aerospace and defence sector for Navantia, while also contributing as a full-stack engineer to a logistics order-tracking product.",
    current: true,
    i18nKey: "experience.item1",
  },
  {
    date: "Sep 2025 — Nov 2025",
    title: "Cybersecurity Intern",
    company: "ALTEN Spain",
    description: "Worked on network analysis and secure software development activities for Telefónica, expanding my engineering background with practical security experience.",
    i18nKey: "experience.item2",
  },
  {
    date: "Jun 2023 — Dec 2023",
    title: "Development Intern",
    company: "ALTEN Spain",
    description: "Contributed to software projects including C4IP and Digital Twin initiatives, technical documentation and agile delivery within multidisciplinary teams.",
    i18nKey: "experience.item3",
  },
  {
    date: "Mar 2023 — Jun 2023",
    title: "Development Intern",
    company: "Surcontrol S.L.",
    description: "Developed, tested and debugged software in a production-oriented industrial environment.",
    i18nKey: "experience.item4",
  },
];
---

<section id="experience" class="relative isolate scroll-m-24 overflow-hidden border-y border-zinc-200/75 bg-white/50 px-6 py-20 backdrop-blur-[2px] sm:py-24 lg:px-8 dark:border-zinc-800/80 dark:bg-zinc-950/30">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(40rem_28rem_at_90%_18%,rgba(37,99,235,0.045),transparent_72%)] dark:bg-[radial-gradient(42rem_30rem_at_90%_18%,rgba(59,130,246,0.055),transparent_72%)]"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-blue-500/20 to-transparent dark:via-blue-400/15"></div>
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400" data-i18n="experience.eyebrow">Experience</p>
        <h2 class="mt-3 text-4xl font-bold tracking-[-0.04em] text-zinc-950 sm:text-5xl dark:text-white" data-i18n="experience.heading">Engineering in real-world environments.</h2>
        <p class="mt-5 max-w-lg text-base leading-7 text-zinc-600 dark:text-zinc-400" data-i18n="experience.intro">From industrial software to aerospace, defence, logistics and cybersecurity, my experience has been shaped by complex systems and multidisciplinary teams.</p>
      </div>

      <ol class="divide-y divide-zinc-200 border-t border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800" aria-label="Professional experience" data-i18n-aria-label="experience.aria">
        {EXPERIENCE.map((experience) => <li><ExperienceItem {...experience} /></li>)}
      </ol>
    </div>
  </div>
</section>
