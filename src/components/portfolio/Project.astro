---
const { title, url, image, languages, description, descriptionKey, size = "xs" } = Astro.props;
import { Icon } from "astro-icon/components";
import Capsule from "../ui/Capsule.astro";
---

<a href={url} class="group block h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-4 dark:focus-visible:ring-offset-zinc-950">
  <article class="glass-surface flex h-full flex-col overflow-hidden rounded-2xl transition duration-300 group-hover:-translate-y-1 group-hover:border-zinc-300/90 group-hover:bg-white/80 group-hover:shadow-xl group-hover:shadow-zinc-950/[0.07] dark:group-hover:border-zinc-700/90 dark:group-hover:bg-zinc-900/70 dark:group-hover:shadow-black/20">
    <div class="relative aspect-[16/10] overflow-hidden border-b border-zinc-200/75 bg-zinc-100/75 dark:border-zinc-800/80 dark:bg-zinc-800/75">
      <img class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" src={image.url} alt={image.alt} loading="lazy" />
      <span class="absolute right-3 top-3 inline-flex size-9 items-center justify-center rounded-xl border border-white/20 bg-zinc-950/70 text-white shadow-lg backdrop-blur"><Icon name="arrow-left" class="size-4 rotate-180 transition-transform group-hover:translate-x-0.5" aria-hidden="true" /></span>
    </div>

    <div class="flex flex-1 flex-col p-6">
      <div class="flex items-center justify-between gap-4">
        <h3 class="text-2xl font-bold tracking-[-0.03em] text-zinc-950 dark:text-white">{title}</h3>
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400" data-i18n="projects.caseStudy">Case study</span>
      </div>
      <p class="mt-3 line-clamp-4 text-sm leading-6 text-zinc-600 dark:text-zinc-400" data-i18n={descriptionKey}>{description}</p>
      <div class="mt-auto flex flex-wrap gap-2 pt-6">{languages.slice(0, 5).map((language: string) => <Capsule size={size} linkEnabled={false} lang={language} />)}</div>
    </div>
  </article>
</a>
