---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import Tools from "./Tools.astro";
import Hobbies from "./Hobbies.astro";
import Button from "../ui/Button.astro";
import CVDropdown from "../ui/CVDropdown.astro";

const [staticData] = await getCollection("staticData");
const { profileAlt, profileImage, profileName, email, emailIconName, github, linkedin } = staticData.data;
---

<section id="home" class="relative isolate scroll-m-24 overflow-hidden px-6 pb-20 pt-14 sm:pt-20 lg:px-8 lg:pb-28 lg:pt-24" aria-label="Professional profile and introduction" data-i18n-aria-label="hero.aria">
  <div class="pointer-events-none absolute left-1/2 top-[-18rem] -z-10 h-[38rem] w-[66rem] -translate-x-1/2 rounded-full bg-blue-500/[0.075] blur-[120px] dark:bg-blue-500/[0.095]"></div>
  <div class="pointer-events-none absolute right-[-18rem] top-[30rem] -z-10 h-[34rem] w-[34rem] rounded-full bg-cyan-400/[0.035] blur-[110px] dark:bg-cyan-400/[0.05]"></div>
  <div class="mx-auto max-w-7xl">
    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div class="max-w-3xl">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-zinc-200/80 bg-white/70 px-3 py-1.5 backdrop-blur-xl text-xs font-semibold text-zinc-600 shadow-sm dark:border-zinc-800/80 dark:bg-zinc-900/60 dark:text-zinc-300">
          <span class="size-2 rounded-full bg-emerald-500 shadow-[0_0_0_4px_rgba(16,185,129,0.12)]"></span>
          <span data-i18n="hero.availability">Open to international opportunities</span>
        </div>

        <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400" data-i18n="hero.location">Software Engineer · Spain</p>
        <h1 class="max-w-4xl text-5xl font-bold tracking-[-0.055em] text-zinc-950 sm:text-6xl lg:text-7xl dark:text-white" data-i18n-html="hero.headlineHtml">
          I build reliable software with a focus on <span class="text-blue-600 dark:text-blue-400">product, systems and security.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-zinc-600 sm:text-xl dark:text-zinc-400" data-i18n="hero.intro">
          I'm {profileName}, a software engineer with 3+ years of experience working across aerospace, defence and logistics. I enjoy turning complex requirements into clear, maintainable products and I'm growing toward senior international roles.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button link={`mailto:${email}`} text="Let's talk" i18nKey="hero.talk" iconName={emailIconName} />
          <CVDropdown
            text="Download CV"
            textKey="hero.downloadCv"
            iconName="cv"
            options={[
              { label: "English CV", labelKey: "cv.en", lang: "EN", url: "/files/AlfredoRamosGarcia_en.pdf" },
              { label: "Spanish CV", labelKey: "cv.es", lang: "ES", url: "/files/AlfredoRamosGarcia_es.pdf" },
              { label: "French CV", labelKey: "cv.fr", lang: "FR", url: "/files/AlfredoRamosGarcia_fr.pdf" },
              { label: "German CV", labelKey: "cv.de", lang: "DE", url: "/files/AlfredoRamosGarcia_de.pdf" },
              { label: "Danish CV", labelKey: "cv.da", lang: "DA", url: "/files/AlfredoRamosGarcia_da.pdf" },
              { label: "Chinese CV", labelKey: "cv.zh", lang: "中文", url: "/files/AlfredoRamosGarcia_zh.pdf" },
            ]}
          />
          <Button link={github} text="GitHub" iconName="github" variant="dark" isExternal={true} />
        </div>

        <div class="mt-10 grid max-w-2xl grid-cols-3 gap-5 border-t border-zinc-200 pt-6 dark:border-zinc-800">
          <div><p class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white">3+</p><p class="mt-1 text-xs font-medium uppercase tracking-wider text-zinc-500" data-i18n="hero.years">Years building</p></div>
          <div><p class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white">3</p><p class="mt-1 text-xs font-medium uppercase tracking-wider text-zinc-500" data-i18n="hero.featuredProjects">Featured projects</p></div>
          <div><p class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white">ES · EN</p><p class="mt-1 text-xs font-medium uppercase tracking-wider text-zinc-500" data-i18n="hero.workingLanguages">Working languages</p></div>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:mx-0 lg:ml-auto">
        <div class="absolute -inset-8 -z-10 rounded-full bg-blue-500/10 blur-3xl dark:bg-blue-500/10"></div>
        <div class="glass-surface overflow-hidden rounded-[2rem] p-3 shadow-2xl shadow-zinc-950/[0.08] dark:shadow-black/25">
          <div class="relative aspect-[4/5] overflow-hidden rounded-[1.55rem] bg-zinc-100 dark:bg-zinc-800">
            <img src={profileImage} alt={profileAlt} class="h-full w-full object-cover" width="620" height="775" fetchpriority="high" />
            <div class="absolute inset-x-3 bottom-3 rounded-2xl border border-white/20 bg-zinc-950/75 p-4 text-white shadow-lg backdrop-blur-xl">
              <div class="flex items-center justify-between gap-4">
                <div><p class="text-sm font-semibold">{profileName}</p><p class="mt-0.5 text-xs text-zinc-300" data-i18n="hero.role">Software Engineer</p></div>
                <a href={linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex size-10 items-center justify-center rounded-xl bg-white/10 transition hover:bg-white/20" aria-label="LinkedIn profile" data-i18n-aria-label="hero.linkedinAria"><Icon name="linkedin" class="size-4.5" /></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 grid gap-4 lg:grid-cols-[1.65fr_0.7fr_0.7fr]">
      <article class="glass-surface rounded-2xl p-6">
        <div class="mb-5 flex items-center gap-3">
          <span class="inline-flex size-9 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400"><Icon name="dashboard" class="size-4.5" /></span>
          <div><h2 class="text-sm font-bold text-zinc-950 dark:text-white" data-i18n="hero.coreStack">Core stack</h2><p class="text-xs text-zinc-500" data-i18n="hero.coreStackSubtitle">Technologies I work with</p></div>
        </div>
        <Tools size="xs" />
      </article>

      <article class="glass-surface rounded-2xl p-6">
        <span class="inline-flex size-9 items-center justify-center rounded-xl bg-violet-50 text-violet-600 dark:bg-violet-500/10 dark:text-violet-400"><Icon name="rocket" class="size-4.5" /></span>
        <h2 class="mt-5 text-lg font-bold tracking-tight text-zinc-950 dark:text-white" data-i18n="hero.currentFocus">Current focus</h2>
        <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400" data-i18n="hero.currentFocusText">System design, cloud-native development, cybersecurity and stronger engineering fundamentals.</p>
      </article>

      <article class="glass-surface rounded-2xl p-6">
        <span class="inline-flex size-9 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-400"><Icon name="person" class="size-4.5" /></span>
        <h2 class="mt-5 text-lg font-bold tracking-tight text-zinc-950 dark:text-white" data-i18n="hero.beyondCode">Beyond code</h2>
        <div class="mt-3"><Hobbies /></div>
      </article>
    </div>
  </div>
</section>
