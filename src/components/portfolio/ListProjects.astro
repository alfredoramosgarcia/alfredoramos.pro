---
import Project from "./Project.astro";
const allPosts = await Astro.glob("../../pages/portfolio/projects/*.md");
allPosts.sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());
---

<section id="projects" class="relative isolate scroll-m-24 overflow-hidden px-6 py-20 sm:py-24 lg:px-8">
  <div class="section-grid-accent -z-20 opacity-[0.55] dark:opacity-[0.45]"></div>
  <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[34rem] w-[76rem] -translate-x-1/2 -translate-y-1/2 rounded-[100%] bg-blue-500/[0.035] blur-[110px] dark:bg-blue-500/[0.055]"></div>
  <div class="pointer-events-none absolute -right-48 bottom-8 -z-10 h-80 w-80 rounded-full bg-cyan-400/[0.03] blur-[100px] dark:bg-cyan-400/[0.045]"></div>
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">Selected work</p>
        <h2 class="mt-3 text-4xl font-bold tracking-[-0.04em] text-zinc-950 sm:text-5xl dark:text-white">Projects built to solve, learn and ship.</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-zinc-600 dark:text-zinc-400">A selection of products where I combine engineering, UI decisions and real deployment. Open a project to see the stack and implementation details.</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {allPosts.map((post) => (
        <Project
          url={post.url}
          title={post.frontmatter.title}
          description={post.frontmatter.description}
          date={post.frontmatter.pubDate}
          languages={post.frontmatter.languages}
          image={post.frontmatter.image}
        />
      ))}
    </div>
  </div>
</section>
