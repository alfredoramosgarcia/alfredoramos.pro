---
interface Props {
  title: string;
  company: string;
  description: string;
  date: string;
  i18nKey: string;
  current?: boolean;
}
const { title, company, description, date, i18nKey, current = false } = Astro.props;
---

<article class="grid gap-4 py-8 sm:grid-cols-[10rem_1fr] sm:gap-8">
  <div>
    <p class="text-sm font-medium text-zinc-500 dark:text-zinc-500" data-i18n={`${i18nKey}.date`}>{date}</p>
    {current && <span class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"><span class="size-1.5 rounded-full bg-emerald-500"></span><span data-i18n="experience.current">Current</span></span>}
  </div>
  <div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-xl font-bold tracking-tight text-zinc-950 dark:text-white" data-i18n={`${i18nKey}.title`}>{title}</h3>
      <span class="text-sm font-semibold text-blue-600 dark:text-blue-400">{company}</span>
    </div>
    <p class="mt-3 max-w-2xl text-base leading-7 text-zinc-600 dark:text-zinc-400" data-i18n={`${i18nKey}.description`}>{description}</p>
  </div>
</article>
