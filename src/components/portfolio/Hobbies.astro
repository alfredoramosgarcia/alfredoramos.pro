---
import { getCollection } from "astro:content";
import Hobbie from "./Hobbie.astro";
const [staticData] = await getCollection("staticData");
interface Props { variant?: "default" | "vertical"; }
const { variant = "default" } = Astro.props as Props;
---

<div class:list={["flex gap-2", variant === "vertical" ? "flex-col items-start" : "flex-wrap items-center"]}>
  {staticData.data.hobbies.map((hobby) => <Hobbie tag={hobby} />)}
</div>
