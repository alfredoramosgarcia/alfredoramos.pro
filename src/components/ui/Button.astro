---
type ButtonVariant = "default" | "big" | "dark";

interface Props {
  link: string;
  text?: string;
  i18nKey?: string;
  iconName?: string;
  variant?: ButtonVariant;
  ariaLabel?: string;
  disabled?: boolean;
  isLoading?: boolean;
  isExternal?: boolean;
  isActive?: boolean;
  class?: string;
}

const {
  link,
  text,
  i18nKey,
  iconName,
  variant = "default",
  ariaLabel,
  disabled = false,
  isLoading = false,
  isExternal = false,
  isActive = false,
  class: className = "",
} = Astro.props as Props;

import { Icon } from "astro-icon/components";

const baseClasses = "inline-flex w-fit items-center justify-center gap-2 rounded-xl border px-5 py-3 text-sm font-semibold transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950";
const variantClasses: Record<ButtonVariant, string> = {
  default: "border-blue-600 bg-blue-600 text-white shadow-sm shadow-blue-600/20 hover:-translate-y-0.5 hover:bg-blue-500 hover:border-blue-500",
  big: "border-blue-600 bg-blue-600 px-6 py-3.5 text-base text-white shadow-sm shadow-blue-600/20 hover:-translate-y-0.5 hover:bg-blue-500 hover:border-blue-500",
  dark: "border-zinc-200 bg-white text-zinc-900 hover:-translate-y-0.5 hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:border-zinc-600 dark:hover:bg-zinc-800",
};
const isExternalLink = isExternal || link.startsWith("http");
const externalAttributes = isExternalLink ? { target: "_blank", rel: "noopener noreferrer" } : {};
const buttonAriaLabel = ariaLabel || text;
const loadingText = isLoading ? "Loading..." : text;
---

<a
  class:list={[baseClasses, variantClasses[variant], disabled && "pointer-events-none opacity-50", className]}
  href={disabled ? "#" : link}
  aria-label={buttonAriaLabel}
  data-i18n-aria-label={i18nKey}
  aria-disabled={disabled}
  aria-busy={isLoading}
  aria-pressed={isActive}
  {...externalAttributes}
>
  {iconName && <Icon name={iconName} class="size-4.5" aria-hidden="true" />}
  {isLoading && <span class="size-4 animate-spin rounded-full border-2 border-current border-r-transparent" aria-hidden="true"></span>}
  <span data-i18n={i18nKey}>{loadingText}</span>
</a>
