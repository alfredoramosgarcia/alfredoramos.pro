---
import { Icon } from "astro-icon/components";
import { getLanguage } from "../../utils/languages";

interface Props {
  lang: string;
  size?: "xs" | "md";
  linkEnabled?: boolean;
}

const { size = "md", lang, linkEnabled = true } = Astro.props as Props;
const selectedLanguage = getLanguage(lang);
const iconSize = size === "xs" ? "size-4" : "size-5";
const classes = "inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white/70 px-2.5 py-1.5 text-xs font-medium text-zinc-700 shadow-sm shadow-zinc-950/[0.02] backdrop-blur transition-colors dark:border-zinc-800 dark:bg-zinc-900/70 dark:text-zinc-300";
---

{linkEnabled ? (
  <a class={`${classes} hover:border-blue-300 hover:text-blue-700 dark:hover:border-blue-800 dark:hover:text-blue-300`} href={`/blog/techs/${lang}`} aria-label={`View articles about ${selectedLanguage.name}`}>
    <span class:list={["flex items-center justify-center", iconSize, selectedLanguage.className || ""]} aria-hidden="true">
      <Icon class="h-full w-full" name={selectedLanguage.iconName} />
    </span>
    {selectedLanguage.name}
  </a>
) : (
  <span class={classes}>
    <span class:list={["flex items-center justify-center", iconSize, selectedLanguage.className || ""]} aria-hidden="true">
      <Icon class="h-full w-full" name={selectedLanguage.iconName} />
    </span>
    {selectedLanguage.name}
  </span>
)}
