---
const { title } = Astro.props;
---

<aside class="hidden xl:block">
  <div class="glass-surface sticky top-28 rounded-2xl p-5">
    <p class="text-xs font-bold uppercase tracking-[0.15em] text-zinc-400">On this page</p>
    <ul id="toc-list" class="mt-4 space-y-1 border-l border-zinc-200 pl-3 dark:border-zinc-800">
      <li><a class="toc-link block rounded-lg px-2 py-1.5 text-sm font-semibold text-zinc-950 dark:text-white" href="#start">{title}</a></li>
    </ul>
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toc = document.getElementById('toc-list');
    const content = document.getElementById('content');
    if (!toc || !content) return;

    const headings = Array.from(content.querySelectorAll('h2, h3'));
    headings.forEach((heading, index) => {
      if (!heading.id) {
        const base = heading.textContent?.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || `section-${index}`;
        heading.id = `${base}-${index}`;
      }
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent?.trim() || heading.id;
      link.className = `toc-link block rounded-lg py-1.5 text-sm leading-5 text-zinc-500 transition hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white ${heading.tagName === 'H3' ? 'pl-5 pr-2' : 'px-2'}`;
      li.appendChild(link);
      toc.appendChild(li);
    });

    const links = Array.from(toc.querySelectorAll('.toc-link'));
    const setActive = (id) => links.forEach((link) => {
      const active = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('text-blue-600', active);
      link.classList.toggle('dark:text-blue-400', active);
      link.classList.toggle('font-semibold', active);
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) setActive(entry.target.id); });
    }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });

    document.getElementById('start') && observer.observe(document.getElementById('start'));
    headings.forEach((heading) => observer.observe(heading));
  });
</script>
